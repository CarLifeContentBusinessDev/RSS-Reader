{
  "buildCommand": "npm run build",
  "functions": {
    "api/convertAudio.ts": {
      "maxDuration": 300,
      "memory": 2048,
      "includeFiles": "node_modules/@ff{mpeg,probe}-installer/linux-x64/**"
    },
    "api/convertAndUploadAudio.ts": {
      "maxDuration": 300,
      "memory": 2048,
      "includeFiles": "node_modules/@ff{mpeg,probe}-installer/linux-x64/**"
    },
    "api/*.ts": {
      "maxDuration": 60,
      "memory": 1024
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    }
  ]
}
